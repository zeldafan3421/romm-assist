# Base URL of your RomM instance
ROMM_BASE_URL=http://localhost:8080

# Preferred: a Client API Token (Administration -> Client API Tokens in RomM)
ROMM_API_TOKEN=rmm_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Alternative to the token above: basic auth credentials
# ROMM_USERNAME=admin
# ROMM_PASSWORD=changeme

# --- Optional local LLM (llama.cpp), only used by docker-compose.llm.yml ---
# See README.md#optional-local-llm-llamacpp
# Host port the llama.cpp OpenAI-compatible server is published on.
# LLAMACPP_PORT=8080

# Hugging Face repo/file downloaded automatically on first start and cached
# in the llamacpp-models volume. Swap these for any other GGUF model.
# LLAMACPP_HF_REPO=Qwen/Qwen2.5-1.5B-Instruct-GGUF
# LLAMACPP_HF_FILE=qwen2.5-1.5b-instruct-q4_k_m.gguf

# Resource tuning for CPU-only boxes; raise LLAMACPP_N_GPU_LAYERS if you have
# a GPU llama.cpp image variant available.
# LLAMACPP_CTX_SIZE=4096
# LLAMACPP_THREADS=4
# LLAMACPP_N_GPU_LAYERS=0

# Unset/empty = no auth required. Set this if the port is reachable beyond a
# trusted network.
# LLAMACPP_API_KEY=
